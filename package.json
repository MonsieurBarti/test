{
  "name": "schemadiff",
  "version": "0.1.0",
  "description": "Compare two JSON Schema files and identify differences",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "schemadiff": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:bin": "bun compile dist/index.js --compile --outfile dist/schemadiff",
    "start": "node dist/index.js"
  },
  "keywords": [
    "json-schema",
    "diff",
    "schema",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0",
    "bun": "^1.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
