{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": ["name"]
    },
    {
      "properties": {
        "email": {
          "type": "string"
        }
      }
    }
  ],
  "anyOf": [
    {
      "properties": {
        "phone": {
          "type": "string"
        }
      }
    }
  ],
  "oneOf": [
    {
      "properties": {
        "address": {
          "type": "string"
        }
      }
    }
  ]
}
